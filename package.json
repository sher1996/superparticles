{
  "name": "superparticles",
  "version": "0.2.0-alpha.1",
  "description": "Ultra-light TypeScript particle engine with Canvas2D, WebGL2 and WebGPU renderers and a plugin system",
  "keywords": [
    "particles",
    "webgpu",
    "webgl2",
    "canvas",
    "neural-cellular-automata",
    "nca",
    "generative",
    "creative-coding"
  ],
  "homepage": "https://github.com/sher1996/superparticles#readme",
  "bugs": {
    "url": "https://github.com/sher1996/superparticles/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sher1996/superparticles.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nca": {
      "types": "./dist/types/src/nca/index.d.ts",
      "import": "./dist/nca.js"
    }
  },
  "files": [
    "dist",
    "models"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.js",
    "start": "esbuild --serve=8000 --servedir=.",
    "typecheck": "tsc -p .",
    "test": "node --test test/core.test.mjs test/nca.test.mjs",
    "test:browser": "node --test test/browser.test.mjs",
    "test:webgpu": "node --test test/nca-webgpu.test.mjs"
  },
  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.23.0",
    "playwright": "^1.63.0",
    "typescript": "^5.4.0",
    "webgpu": "^0.3.8"
  }
}
