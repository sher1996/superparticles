# ================================================================
#  bol Opportunity Engine - configuration
#  Copy this file to ".env" and fill in your own values.
#  Never share your .env file or commit it to git.
# ================================================================

# demo = simulated market data (works without any account)
# live = your real bol + AliExpress accounts
ENGINE_MODE=demo

# --- bol seller account: Retailer API (Insights, product list, ranks, offers)
# bol Partner Platform -> Instellingen -> API-instellingen -> "Aanmaken" (client credentials)
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=

# --- bol affiliate account: Marketing Catalog API (prices, details, delivery)
# bol Partnerprogramma -> Open API / Marketing Catalog API credentials
BOL_AFFILIATE_CLIENT_ID=
BOL_AFFILIATE_CLIENT_SECRET=

# --- AliExpress Affiliate API (AliExpress Open Platform, "Affiliate API" app)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# tracking id from portals.aliexpress.com (optional, for affiliate links)
ALIEXPRESS_TRACKING_ID=

# --- Anthropic API (optional). Without a key everything uses rule-based fallbacks.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# The daily AI cost cap is set on the Settings page (default $0.50/day).

# --- Live mode while an account is still pending: keep these sources simulated.
# Comma separated: bol_retailer, bol_catalog, aliexpress   (empty = none)
MOCK_SOURCES=

# --- Scheduler
SCHEDULER_ENABLED=true
DAILY_RUN_TIME=06:30
TIMEZONE=Europe/Amsterdam
# If the PC was off at the scheduled time, run once when the app starts.
RUN_MISSED_ON_STARTUP=true

# --- Web server (use 0.0.0.0 on a home server to reach it from other devices)
HOST=127.0.0.1
PORT=8000

# --- Storage (relative to this folder)
DB_PATH=data/engine.db
LOG_DIR=logs

# --- Demo only: inject occasional API rate-limit errors to test error handling
DEMO_SIMULATE_ERRORS=false
